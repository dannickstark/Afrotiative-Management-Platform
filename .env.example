# Neon Postgres — pooled (app) and direct (migrations)
# Two branches: .env.local (this file, local dev) → "dev" branch; the deployed host's
# env vars → "production" branch. Never put production creds in a committed file OR here.
DATABASE_URL="postgresql://user:pass@HOST-pooler.neon.tech/db?sslmode=require"
DIRECT_URL="postgresql://user:pass@HOST.neon.tech/db?sslmode=require"
# Set in the PRODUCTION host env only: the production endpoint host (e.g. ep-xxx.neon.tech).
# db:seed refuses to wipe any DB whose host matches this — anti-clobber guard.
PRODUCTION_DB_HOST=""
# Better-Auth
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# SP3 pipeline (all optional — pipeline runs credential-free without them)
LLM_ORDER="openrouter,omniroute"
OPENROUTER_API_KEY=""      # OPENROUTER_MODEL="openai/gpt-4o-mini"
OMNIROUTE_BASE_URL=""      # OMNIROUTE_API_KEY=""  OMNIROUTE_MODEL="auto/chat"
EXTRACT_ORDER="jina,firecrawl,readability"
JINA_API_KEY=""            # covers Jina Reader (extract) AND Jina embeddings
FIRECRAWL_API_KEY=""
EMBED_BASE_URL="https://api.jina.ai/v1"  # EMBED_MODEL="jina-embeddings-v3" EMBED_DIMENSIONS="1024"
CLUSTER_THRESHOLD="0.83"   # MAX_ITEMS_PER_RUN="20"  CLUSTER_WINDOW_HOURS="72"
PIPELINE_TRIGGER_SECRET="" # required for the cron POST /api/pipeline/run
# Optional additional LLM providers (add to LLM_ORDER to use):
ANTHROPIC_API_KEY=""       # ANTHROPIC_MODEL="claude-3-5-haiku-latest"
OPENAI_API_KEY=""          # OPENAI_MODEL="gpt-4o-mini"
GOOGLE_GENERATIVE_AI_API_KEY=""  # GOOGLE_MODEL="gemini-2.0-flash"
# Embeddings key (defaults to JINA_API_KEY if unset):
EMBED_API_KEY=""
# SP4 optional web-search provider chain (also requires pipeline_settings.web_search_enabled=true;
# off/no-op when that setting is false, or falls through to [] if no key below is set — see
# lib/search/index.ts). Tried in SEARCH_ORDER; a missing key skips that provider, a provider error
# (quota/429, auth, network) falls through to the next one.
SEARCH_ORDER="brave,exa"
BRAVE_SEARCH_API_KEY=""
EXA_API_KEY=""             # https://exa.ai — fallback behind Brave

# SP9 failure alerting — e-mail is OPTIONAL and OFF by default. In-app alerts (bell + dashboard
# banner) always work with no config. E-mail is sent only when ALL of: pipeline_settings.alert_email_enabled
# is on (toggle in /settings/pipeline), alert_email_recipients is set there, AND RESEND_API_KEY below is
# present. No-op (never throws) otherwise. Provider: Resend (https://resend.com).
RESEND_API_KEY=""
ALERT_EMAIL_FROM="alerts@afrotiative.local"  # "From" address for alert e-mails (defaults to this if unset)

# SP5 WordPress publishing — leave all four empty to keep publishing disabled
# (getWpConfig() returns null and the publish loop no-ops until every WP_* var is set).
WP_BASE_URL=""       # e.g. "https://example.com" (no trailing slash needed)
WP_USER=""           # WordPress username tied to the Application Password below
WP_APP_PASSWORD=""   # WordPress Application Password (spaces are stripped automatically)
PUBLISH_TRIGGER_SECRET="" # required to authorize the publish-trigger cron endpoint

# D1 diffusion sociale — optionnel, défaut 10 (minutes). Seuil au-delà duquel une ligne
# `distributions` restée 'pending' est considérée abandonnée par un crash de processus et marquée
# 'failed' par le tic planificateur (voir docs/DEPLOYMENT.md §6.5) — même convention que
# RUN_STALE_MINUTES (lib/config/pipeline-config.ts) pour pipeline_runs. Sûr à 10 min tant qu'aucun
# adaptateur réel n'existe (StubChannel.send ne fait aucun I/O) ; à revisiter contre la latence
# réelle du premier adaptateur livré (D2).
DIFFUSION_STALE_PENDING_MINUTES="10"

# Task 1 (D2+D3) — clé de chiffrement des identifiants réseaux sociaux (Page Facebook/Instagram,
# futur URN LinkedIn…) stockés dans social_channel_settings.credentials (AES-256-GCM,
# lib/diffusion/crypto.ts). Générer avec : openssl rand -base64 32
# Laissée vide, getCryptoConfig() renvoie null : la fonctionnalité se désactive proprement — un
# admin ne peut simplement plus enregistrer d'identifiant sur /settings/social/[canal] (message
# français explicite), rien ne plante. Une fois des identifiants enregistrés SOUS cette clé,
# NE JAMAIS LA PERDRE NI LA CHANGER SANS RE-SAISIR LES IDENTIFIANTS : ils deviennent
# irrécupérables (le chiffrement n'a pas de porte dérobée) — traiter comme un secret de production
# au même titre que BETTER_AUTH_SECRET, sauvegardé dans le gestionnaire de secrets de l'hôte.
CREDENTIALS_ENCRYPTION_KEY=""

# Studio de gabarits (V1 moteur + V2 éditeur /studio, /studio/[id], /studio/assets, /studio/generer)
# — stockage Cloudflare R2. Laisser les cinq vides désactive proprement le studio : getStudioConfig()
# renvoie null, aucun rendu n'est tenté, et l'interface bascule en lecture seule avec une bannière
# explicite (docs/DEPLOYMENT.md).
R2_ACCOUNT_ID=""          # identifiant de compte Cloudflare
R2_ACCESS_KEY_ID=""       # jeton API R2
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""              # nom du bucket, ex. "afrotiative-media"
R2_PUBLIC_BASE_URL=""     # base des URLs publiques, ex. "https://media.afrotiative.com"
# Optionnel : URL du logo de marque injecté dans le jeton {{brand.logo}} (lib/studio/bindings.ts).
# Laissé vide, le jeton est simplement absent des valeurs — tout gabarit qui utilise {{brand.logo}}
# échoue alors avec « Valeurs manquantes pour : brand.logo. ».
STUDIO_BRAND_LOGO_URL=""

# Dev/ops scripts only (not read by the running app):
#   bun run db:create-admin — bootstrap a production admin account
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""
#   bun run db:seed — destructive demo seed; refuses to run unless CONFIRM_SEED=1 (and never on PRODUCTION_DB_HOST)
CONFIRM_SEED=""
