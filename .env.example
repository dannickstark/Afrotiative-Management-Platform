# Neon Postgres — pooled (app) and direct (migrations)
DATABASE_URL="postgresql://user:pass@HOST-pooler.neon.tech/db?sslmode=require"
DIRECT_URL="postgresql://user:pass@HOST.neon.tech/db?sslmode=require"
# Better-Auth
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# SP3 pipeline (all optional — pipeline runs credential-free without them)
LLM_ORDER="openrouter,omniroute"
OPENROUTER_API_KEY=""      # OPENROUTER_MODEL="openai/gpt-4o-mini"
OMNIROUTE_BASE_URL=""      # OMNIROUTE_API_KEY=""  OMNIROUTE_MODEL="auto/chat"
EXTRACT_ORDER="jina,firecrawl,readability"
JINA_API_KEY=""            # covers Jina Reader (extract) AND Jina embeddings
FIRECRAWL_API_KEY=""
EMBED_BASE_URL="https://api.jina.ai/v1"  # EMBED_MODEL="jina-embeddings-v3" EMBED_DIMENSIONS="1024"
CLUSTER_THRESHOLD="0.83"   # MAX_ITEMS_PER_RUN="20"  CLUSTER_WINDOW_HOURS="72"
PIPELINE_TRIGGER_SECRET="" # required for the cron POST /api/pipeline/run
# Optional additional LLM providers (add to LLM_ORDER to use):
ANTHROPIC_API_KEY=""       # ANTHROPIC_MODEL="claude-3-5-haiku-latest"
OPENAI_API_KEY=""          # OPENAI_MODEL="gpt-4o-mini"
GOOGLE_GENERATIVE_AI_API_KEY=""  # GOOGLE_MODEL="gemini-2.0-flash"
# Embeddings key (defaults to JINA_API_KEY if unset):
EMBED_API_KEY=""

# SP5 WordPress publishing — leave all four empty to keep publishing disabled
# (getWpConfig() returns null and the publish loop no-ops until every WP_* var is set).
WP_BASE_URL=""       # e.g. "https://example.com" (no trailing slash needed)
WP_USER=""           # WordPress username tied to the Application Password below
WP_APP_PASSWORD=""   # WordPress Application Password (spaces are stripped automatically)
PUBLISH_TRIGGER_SECRET="" # required to authorize the publish-trigger cron endpoint
